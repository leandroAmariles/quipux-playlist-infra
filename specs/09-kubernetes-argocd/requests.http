%}

### FR-002 / US1-3 "/actuator/health raíz sigue protegido sin token" — expects 401
GET {{baseUrl}}/actuator/health

> {%
client.test("actuator root health requires auth", function () {
    client.assert(response.status === 401, "Expected 401, got " + response.status);
});
%}

### FR-002 / US1-3 "otros endpoints de Actuator (/actuator/env) siguen protegidos sin token" — expects 401
GET {{baseUrl}}/actuator/env

> {%
client.test("actuator env requires auth", function () {
    client.assert(response.status === 401, "Expected 401, got " + response.status);
});
%}

### FR-003 / US1-3 "sonda HTTP del frontend en GET / sin token" — expects 200
GET {{webUrl}}/

> {%
client.test("frontend root returns 200 without auth", function () {
    client.assert(response.status === 200, "Expected 200, got " + response.status);
});
%}
